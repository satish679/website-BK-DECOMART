# Copy this file to `.env` in the same folder and fill in real values.

# MongoDB connection string. Free tier works fine: https://www.mongodb.com/cloud/atlas/register
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=bk_decomart

# Comma-separated list of allowed frontend origins. Use * for local dev only.
CORS_ORIGINS=http://localhost:3000
